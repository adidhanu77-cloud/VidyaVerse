# VidyaVerse - Environment Variables Example
# Duplicate this file as .env and fill in your values.

# Google Gemini AI Key (for backend story generation)
GEMINI_API_KEY=your_gemini_api_key_here
# Google Gemini AI Key (exposed to browser via Vite for real-time client-side generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend Port
PORT=5000

# Supabase Configuration (Authentication & Database)
# Get these from your Supabase Project Settings > API
VITE_SUPABASE_URL=https://dhkjupeuxmfsrlrgyzjf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRoa2p1cGV1eG1mc3Jscmd5empmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ5MjYxMDIsImV4cCI6MjExMDUwMjEwMn0.4rRRp7409E-uPS5vgumUeb9FMPar9U2YnURWw0lDoZM
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# Firebase Authentication (Gmail OAuth & Phone OTP)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Twilio Parent Notification Service (WhatsApp & SMS)
# Get these from Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_sms_phone_number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
